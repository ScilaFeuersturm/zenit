{
  "expo": {
    "name": "Eventos Zenit",
    "slug": "eventos-zenit",
    "scheme": "eventoszenit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventoszenit.app"
    },
    "android": {
      "package": "com.eventoszenit.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://localhost:8000",
      "wsUrl": "ws://localhost:8000",
      "siteUrl": "https://zenit-web-7kcw.onrender.com"
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
