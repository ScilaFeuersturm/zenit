# Entorno
ENVIRONMENT=development

# Base de datos
# SQLite (por defecto, ideal para arrancar en el VPS sin configurar nada extra)
DATABASE_URL=sqlite:///./zenit.db
# Postgres (recomendado si el VPS de Hostinger ya tiene Postgres disponible)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/zenit_eventos

# Seguridad JWT
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (dominios permitidos, separados por coma)
# 8081 = Metro por defecto, 19006 = `expo start --web`, 5501 = preview de landing/
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5501,exp://192.168.1.100:8081

# Admin inicial (se crea automáticamente si no existe ningún admin)
FIRST_ADMIN_EMAIL=admin@eventoszenit.com
FIRST_ADMIN_PASSWORD=cambiar123
FIRST_ADMIN_NAME=Administrador Zenit
